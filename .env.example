# R3 GLOBAL AFFILIATE NETWORK — ENVIRONMENT CONFIGURATION TEMPLATE

# Host & Runtime URL
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Supabase PostgreSQL & Auth Credentials (Client side: VITE_ prefix)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Server-Side Service Role (Keep secret, never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Security & Session Token Secret
SESSION_SECRET="r3-contingencies-session-secret-key-change-in-production"

# Optional Gemini AI API Key
GEMINI_API_KEY=""
